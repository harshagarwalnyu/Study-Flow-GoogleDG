# Copy to server/.env
PORT=3000
GEMINI_API_KEY=
# Optional overrides; defaults live in packages/shared/src/env/server.ts
GEMINI_MODEL=
GEMINI_FAST_MODEL=
FIREBASE_PROJECT_ID=your-project
# Path to a Firebase service-account JSON. Keep it OUTSIDE the repo; never commit it.
GOOGLE_APPLICATION_CREDENTIALS=
# Comma-separated, e.g. http://localhost:5173,chrome-extension://<extension-id>
ALLOWED_ORIGINS=
# Proxy hops in front of the server (1 on Cloud Run / behind one load balancer). Needed for real client IPs.
TRUST_PROXY=
# memory (per instance, default) | firestore (AI limit shared across instances; enable TTL on rateLimits.expireAt)
RATE_LIMIT_STORE=
RATE_LIMIT_IP_PER_MINUTE=
RATE_LIMIT_AI_PER_MINUTE=
