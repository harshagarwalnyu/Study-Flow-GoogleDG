{
  "name": "server",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "start": "bun src/index.ts",
    "typecheck": "tsc --noEmit",
    "reembed": "bun src/scripts/reembed-cli.ts",
    "eval": "bun src/eval/cli.ts"
  },
  "dependencies": {
    "@google-cloud/vision": "^6.1.0",
    "@google/genai": "^2.24.0",
    "@study-flow/shared": "workspace:*",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "firebase-admin": "^14.5.0",
    "multer": "^2.4.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "ts-fsrs": "5.4.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.2.0",
    "@types/node": "^24.13.6",
    "@types/supertest": "^7.2.1",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitest/coverage-v8": "^5.0.1",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "supertest": "^7.3.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^5.0.1"
  }
}
